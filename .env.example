# ==============================================================================
# FailureFoundry Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your local environment.
# NEVER commit the actual .env file containing secrets.

# Application Settings
APP_NAME=FailureFoundry
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Server Network Settings
HOST=127.0.0.1
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Settings (Polyglot: SQLite System of Record + Neo4j Graph Projection)
DATABASE_URL=sqlite:///./failurefoundry.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# LLM Providers (for later phases - Phase 3+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# PRISM Monitor Integration (for later phases - Phase 5+)
PRISM_API_KEY=
PRISM_PROJECT_ID=
PRISM_BASE_URL=https://api.blockconvey.com
