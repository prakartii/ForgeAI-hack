# ==============================================================================
# FailureFoundry Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your local environment.
# NEVER commit the actual .env file containing secrets.

# Application Settings
APP_NAME=FailureFoundry
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Server Network Settings
HOST=127.0.0.1
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Settings (Polyglot: SQLite System of Record + Neo4j Graph Projection)
DATABASE_URL=sqlite:///./failurefoundry.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# LLM Providers (for later phases - Phase 3+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# PRISM Monitor Integration (Phase 5). Uses the real, installed `prismtrace`
# SDK (package blockconvey-monitor>=0.3.1, class prismtrace.PRISMtrace).
# Sign up at prism.blockconvey.com/signup for PRISM_API_KEY (format
# pt-sk-...) and PRISM_PROJECT_ID (a uuid). Leave both empty until you
# have real credentials -- the integration reports "not_configured"
# honestly rather than fabricating evidence.
PRISM_API_KEY=
PRISM_PROJECT_ID=
PRISM_BASE_URL=https://prism.blockconvey.com

# CLAUDE.md §23: the release gate requires real PRISM evidence to PASS.
# Set to false only to explicitly acknowledge that PRISM isn't wired up
# yet in this environment and let the gate evaluate on FailureFoundry's
# own criteria alone.
PRISM_EVIDENCE_REQUIRED=true
